rules_version = '2';

// F1 Grand Prix Screening — AWS Club VITB
// Organiser emails: keep this list identical to ADMIN_EMAILS in src/lib/event-config.ts
service cloud.firestore {
  function isAdmin() {
    return request.auth != null && request.auth.token.email.lower() in [
      'neel.24bce10303@vitbhopal.ac.in',
      'neelpandeyofficial@gmail.com'
    ];
  }

  match /databases/{database}/documents {

    // Seat map: anyone can see what's free; holds, waitlist reservations and
    // bookings are written by the booking transaction. A booked seat can only
    // be changed by an organiser.
    match /seats/{seat} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin()
        || resource.data.status == 'held'
        || resource.data.status == 'waitlisted'
        || (resource.data.status == 'booked' && false);
    }

    // One registration number = one booking OR one waiting-list entry.
    // Signed-in visitors may fetch one registration doc to check whether a reg
    // number is already taken (the booking/waitlist transaction reads this
    // doc); only organisers can list, update or delete them.
    match /registrations/{regNo} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // A visitor can create their booking and read it back by its code,
    // but only organisers can list every registration.
    match /bookings/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.status == 'pending' || request.resource.data.status == 'pending_payment';
      allow update, delete: if isAdmin();
    }

    // Payment screenshots: write-only for visitors, readable by organisers.
    match /screenshots/{code} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    // AB02-128 waiting list: visitors create their own entry and can read it
    // back by code; only organisers can list, update or delete entries.
    match /waitlist/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Room state (e.g. whether AB02-128 booking is open): anyone reads,
    // only organisers change it.
    match /config/{name} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Public availability aggregate (taken/held/waitlisted + r2Open).
    // Read by everyone, written by booking transactions & organiser actions.
    match /availability/{doc} {
      allow get: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Public lookup index for /tickets: keys are `email:<lowercase>` and
    // `reg:<UPPERCASE>` and `wl:<waitlist-code>`; values hold only booking /
    // waitlist codes (no PII). Written by the booking/waitlist transactions so
    // visitors can find their own tickets with a `get` (never a `list`).
    match /lookups/{key} {
      allow get: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
